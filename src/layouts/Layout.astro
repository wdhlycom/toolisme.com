---
import '../styles/global.css'
import SiteHeader from '@/components/SiteHeader'

interface Props {
  title?: string
  description?: string
}

const { title = 'Toolisme — Smart minds leverage great tools', description = 'Honest, hands-on reviews of the best SaaS & AI tools — tested, compared, and rated for real work. Skip the trial and error.' } = Astro.props

const footerNav = [
  {
    title: 'Explore',
    links: [
      { to: '/', label: 'Home' },
      { to: '/reviews/software', label: 'Software' },
      { to: '/reviews/creators', label: 'Creators' },
      { to: '/reviews/security', label: 'Security' },
      { to: '/reviews/hardware', label: 'Hardware' },
      { to: '/guides', label: 'Guides' },
      { to: '/guestbook', label: 'Guestbook' },
    ],
  },
  {
    title: 'Company',
    links: [
      { to: '/about', label: 'About Us' },
      { to: '/editorial-team', label: 'Editorial Team' },
      { to: '/methodology', label: 'Methodology' },
      { to: '/about#contact', label: 'Contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { to: '/disclosure', label: 'Disclosure' },
      { to: '/privacy', label: 'Privacy Policy' },
    ],
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;..144,500;9..144,600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      ;(function () {
        try {
          var stored = localStorage.getItem('theme')
          if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark')
          }
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <SiteHeader client:load />

      <main class="flex-1">
        <slot />
      </main>

      <footer class="border-t border-white/10 bg-ink-950">
        <div class="container-page py-14">
          <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
            <div class="lg:col-span-2">
              <a href="/" class="flex items-center gap-2.5">
                <img
                  src="/logo.png"
                  alt="Toolisme"
                  class="h-9 w-9 rounded-full object-cover"
                />
                <span class="font-serif text-xl font-medium tracking-tight text-white">
                  Toolisme
                </span>
              </a>
              <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-300">
                We test, review, and filter the best SaaS & AI tools to multiply your
                productivity. Skip the trial and error.
              </p>
              <div class="mt-6 flex items-center gap-3">
                <a
                  href="https://x.com/toolisme"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="X (Twitter)"
                  class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-ink-200 transition-colors hover:bg-white/20 hover:text-white"
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                    ><path
                      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                    ></path></svg
                  >
                </a>
                <a
                  href="https://github.com/toolisme"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="GitHub"
                  class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-ink-200 transition-colors hover:bg-white/20 hover:text-white"
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                    ><path
                      d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                    ></path></svg
                  >
                </a>
                <a
                  href="https://www.linkedin.com/company/toolisme"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="LinkedIn"
                  class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-ink-200 transition-colors hover:bg-white/20 hover:text-white"
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                    ><path
                      d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
                    ></path></svg
                  >
                </a>
              </div>
            </div>

            {
              footerNav.map((section) => (
                <div>
                  <h3 class="text-xs font-semibold uppercase tracking-widest text-ink-400">
                    {section.title}
                  </h3>
                  <ul class="mt-4 space-y-3">
                    {section.links.map((link) => (
                      <li>
                        <a
                          href={link.to}
                          class="text-sm text-ink-300 transition-colors hover:text-white"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>

          <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center">
            <p class="text-xs text-ink-400">
              &copy; {new Date().getFullYear()} Toolisme. All rights reserved.
            </p>
            <p class="text-xs text-ink-500 dark:text-ink-500">
              Some links on this site are affiliate links.{' '}
              <a
                href="/disclosure"
                class="font-medium text-ink-400 underline underline-offset-2 hover:text-ink-200 dark:text-ink-400 dark:hover:text-ink-200"
              >
                Read our disclosure
              </a>
              .
            </p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
