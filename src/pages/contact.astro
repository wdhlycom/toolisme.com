---
import { Mail, Clock, MapPin } from 'lucide-react'
import PageHeader from '@/components/PageHeader'
import ContactForm from '@/components/ContactForm'
import { contactFaqs } from '@/data/content'
import Layout from '@/layouts/Layout.astro'
---
<Layout title="Contact Toolisme" description="Have a question, a tool to suggest, or a correction to flag? We read every message and respond within two business days.">

<PageHeader
  eyebrow="Get in touch"
  title="Contact Toolisme"
  description="Have a question, a tool to suggest, or a correction to flag? We read every message and respond within two business days."
  breadcrumbs={[{ label: 'Contact' }]}
/>

<section class="container-page py-16">
  <div class="grid gap-12 lg:grid-cols-5">
    {/* Form */}
    <div class="lg:col-span-3">
      <ContactForm client:load />
    </div>

    {/* Info sidebar */}
    <div class="lg:col-span-2">
      <div class="space-y-6">
        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-50 text-accent-700 dark:bg-accent-950 dark:text-accent-300">
              <Mail class="h-5 w-5" />
            </span>
            <div>
              <h3 class="text-sm font-semibold text-ink-900 dark:text-ink-100">Email us</h3>
              <a
                href="mailto:master@toolisme.com"
                class="text-sm text-ink-500 transition-colors hover:text-accent-700 dark:text-ink-400"
              >
                master@toolisme.com
              </a>
            </div>
          </div>
        </div>

        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-sage-50 text-sage-700 dark:bg-sage-950 dark:text-sage-300">
              <Clock class="h-5 w-5" />
            </span>
            <div>
              <h3 class="text-sm font-semibold text-ink-900 dark:text-ink-100">Response time</h3>
              <p class="text-sm text-ink-500 dark:text-ink-400">Within 2 business days</p>
            </div>
          </div>
        </div>

        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-sand-50 text-sand-700 dark:bg-sand-950 dark:text-sand-300">
              <MapPin class="h-5 w-5" />
            </span>
            <div>
              <h3 class="text-sm font-semibold text-ink-900 dark:text-ink-100">Location</h3>
              <p class="text-sm text-ink-500 dark:text-ink-400">Remote-first, operating globally</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl bg-ink-900 p-6 text-white">
          <h3 class="font-serif text-lg font-medium">Press & partnerships</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-300">
            For media inquiries, syndication, or tool-maker partnerships, contact
            us at partnerships@toolisme.com.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{/* FAQ */}
<section class="border-t border-ink-200/70 bg-white py-16 dark:border-ink-700/70 dark:bg-ink-950">
  <div class="container-prose">
    <p class="eyebrow mb-3">Quick answers</p>
    <h2 class="section-title">Frequently asked questions</h2>
    <div class="mt-10 space-y-4">
      {contactFaqs.map((faq) => (
        <details class="group rounded-xl border border-ink-200 bg-white p-5 transition-colors open:bg-ink-50 dark:border-ink-700 dark:bg-ink-900 dark:open:bg-ink-800">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-semibold text-ink-900 marker:content-none dark:text-ink-100">
            {faq.question}
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-ink-100 text-ink-500 transition-transform group-open:rotate-45 dark:bg-ink-800 dark:text-ink-400">
              <span class="text-lg leading-none">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

</Layout>
