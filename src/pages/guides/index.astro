---
import { Clock, Tag, ArrowRight } from 'lucide-react'
import { guides } from '@/content/guides'
import { categories } from '@/data/content'

const sorted = [...guides].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
const sections = categories
  .map((c) => ({ category: c, items: sorted.filter((g) => g.tags.includes(c.slug)) }))
  .filter((s) => s.items.length > 0)
import Layout from '@/layouts/Layout.astro'
---
<Layout title="Buyer's Guides — Toolisme" description="Selection methods we use before any tool earns a spot on Toolisme — broken down by category.">

<section class="bg-white dark:bg-ink-950">
  <div class="container-page py-14">
    <p class="eyebrow">Guides</p>
    <h1 class="mt-2 font-serif text-4xl font-medium tracking-tight text-ink-900 sm:text-5xl">Buyer's guides</h1>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600 text-pretty dark:text-ink-300">
      Selection methods we use before any tool earns a spot on Toolisme — broken down by category so you can pick your lane and follow the steps.
    </p>
  </div>
</section>

<section class="container-page pb-20">
  <div class="space-y-14">
    {sections.map(({ category, items }) => (
      <div>
        <div class="flex items-center gap-3">
          <h2 class="font-serif text-2xl font-medium tracking-tight text-ink-900 dark:text-ink-100">{category.name}</h2>
          <span class="h-px flex-1 bg-ink-200 dark:bg-ink-800"></span>
          <span class="text-xs font-medium text-ink-400 dark:text-ink-500">{items.length} {items.length === 1 ? 'guide' : 'guides'}</span>
        </div>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((guide) => (
            <a href={`/guides/${guide.slug}`} class="card-hover group flex flex-col p-6">
              <div class="flex flex-wrap gap-1.5">
                {guide.tags.map((tag) => (
                  <span class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${categories.find((c) => c.slug === tag)?.accentClass ?? 'bg-ink-100 text-ink-600'}`}>{categories.find((c) => c.slug === tag)?.name ?? tag}</span>
                ))}
              </div>
              <h3 class="mt-3 font-serif text-lg font-medium tracking-tight text-ink-900 group-hover:text-accent-700 dark:text-ink-100 dark:group-hover:text-accent-400">{guide.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600 line-clamp-3 dark:text-ink-300">{guide.summary}</p>
              <div class="mt-5 flex items-center justify-between border-t border-ink-100 pt-4 dark:border-ink-800">
                <span class="flex items-center gap-1 text-xs font-medium text-ink-400 dark:text-ink-500"><Clock class="h-3.5 w-3.5" />{guide.readTime} min read</span>
                <span class="inline-flex items-center gap-1 text-sm font-semibold text-accent-700 group-hover:text-accent-900 dark:text-accent-400 dark:group-hover:text-accent-300">Read guide<ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

</Layout>
