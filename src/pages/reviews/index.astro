---
import Layout from '@/layouts/Layout.astro'
import CategoryCard from '@/components/CategoryCard'
import { categories } from '@/data/content'
---

<Layout title="Reviews — Toolisme" description="Honest, hands-on reviews of the best SaaS & AI tools.">
  <section class="container-page py-16">
    <h1 class="section-title">All categories</h1>
    <p class="mt-3 text-sm text-ink-500 dark:text-ink-400">Browse Toolisme reviews by category.</p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((c) => <CategoryCard category={c} />)}
    </div>
  </section>
</Layout>
