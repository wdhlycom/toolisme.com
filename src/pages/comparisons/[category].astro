---
import Layout from '@/layouts/Layout.astro'
import PageHeader from '@/components/PageHeader'
import ReviewCard from '@/components/ReviewCard'
import { ArrowRight } from 'lucide-react'
import { categories, comparisons } from '@/data/content'

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug } }))
}

const { category: catSlug } = Astro.params
const category = categories.find((c) => c.slug === catSlug)
if (!category) return Astro.redirect('/comparisons')
const categoryReviews = comparisons.filter((r) => r.category === category.slug)
---

<Layout title={`${category.name} Comparisons — Toolisme`} description={category.description}>
  <PageHeader eyebrow={category.tagline} title={`${category.name} comparisons`} description={category.description} breadcrumbs={[{ label: `${category.name}` }]} />
  <section class="container-page py-16">
    <p class="text-sm text-ink-500 dark:text-ink-400">{categoryReviews.length} {categoryReviews.length === 1 ? 'comparison' : 'comparisons'} in {category.name}</p>
    {categoryReviews.length > 0 ? (
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {categoryReviews.map((review) => <ReviewCard review={review} />)}
      </div>
    ) : (
      <div class="mt-8 rounded-2xl border-2 border-dashed border-ink-200 bg-ink-50 p-12 text-center dark:border-ink-700 dark:bg-ink-900">
        <p class="font-serif text-xl font-medium text-ink-700">Comparisons coming soon</p>
      </div>
    )}
  </section>
  <section class="border-t border-ink-200/70 bg-white py-16 dark:border-ink-700/70 dark:bg-ink-950">
    <div class="container-page">
      <h2 class="section-title">Browse other categories</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {categories.filter((c) => c.slug !== category.slug).map((c) => (
          <a href={`/comparisons/${c.slug}`} class="card-hover group flex items-center justify-between p-5">
            <div><h3 class="font-serif text-lg font-medium text-ink-900 dark:text-ink-100">{c.name}</h3><p class="text-sm text-ink-500">{c.toolCount} tools</p></div>
            <ArrowRight class="h-5 w-5 text-ink-300 transition-transform group-hover:translate-x-1 group-hover:text-accent-600" />
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
