---
import Layout from '@/layouts/Layout.astro'
import ReviewCard from '@/components/ReviewCard'
import CategoryCard from '@/components/CategoryCard'
import ComparisonTable from '@/components/ComparisonTable'
import HomeSearch from '@/components/HomeSearch'
import {
  categories,
  reviews,
  comparisons,
  allArticles,
  editorialValues,
  reviewPath,
  type CategorySlug,
} from '@/data/content'
import { guides } from '@/content/guides'
import {
  ArrowRight,
  Star,
  Clock,
  TrendingUp,
  ShieldCheck,
  Hand,
  CalendarClock,
  BadgeCheck,
  BarChart3,
  MonitorSmartphone,
  Clapperboard,
  Cpu,
  BookOpen,
  type LucideIcon,
} from 'lucide-react'

const topPicks = reviews.filter((r) => r.editorsPick).slice(0, 3)
const recentReviews = [...reviews].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
const categoryIcons: Record<CategorySlug, LucideIcon> = {
  software: MonitorSmartphone,
  creators: Clapperboard,
  security: ShieldCheck,
  hardware: Cpu,
}
const categorySubtitles: Record<CategorySlug, string> = {
  software: 'Battle-tested apps that eliminate manual tasks so you can focus on building.',
  creators: 'Turn raw ideas into polished videos and podcasts faster with top-rated creative tools.',
  security: 'Keep your connection encrypted, protect your data, and safeguard your online identity.',
  hardware: 'High-performance gear and workstations built for professionals spending long hours at the desk.',
}
const featuredGuides = [...guides]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3)
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-white dark:bg-ink-950">
    <div class="absolute inset-0 bg-grid mask-fade-b opacity-50"></div>
    <div class="container-page relative py-10 sm:py-12 lg:py-16">
      <div class="mx-auto max-w-5xl rounded-3xl border border-ink-200/80 bg-gradient-to-b from-white via-white to-ink-50/80 p-7 shadow-[0_1px_0_rgba(255,255,255,0.95)_inset,0_-1px_0_rgba(15,23,42,0.05)_inset,0_24px_60px_-15px_rgba(15,23,42,0.35),0_8px_20px_-8px_rgba(15,23,42,0.18)] ring-1 ring-white/60 dark:border-ink-700/80 dark:from-ink-900 dark:via-ink-900 dark:to-ink-950/90 dark:shadow-[0_1px_ 0_rgba(255,255,255,0.10)_inset,0_-1px_0_rgba(0,0,0,0.5)_inset,0_24px_60px_-15px_rgba(0,0,0,0.75),0_8px_20px_-8px_rgba(0,0,0,0.5)] dark:ring-white/5 sm:p-9 lg:max-w-6xl lg:p-12">
        <div class="mx-auto max-w-5xl text-center lg:max-w-7xl">
          <h1 class="-mt-2 pb-3 leading-[1.3] font-serif text-4xl font-medium tracking-tight sm:text-5xl lg:text-6xl xl:text-7xl bg-gradient-to-r from-ink-900 via-accent-700 to-accent-500 bg-clip-text text-transparent animate-gradient-x bg-[length:200%_200%] dark:from-ink-100 dark:via-accent-400 dark:to-accent-300">
            Smart minds leverage great tools.
          </h1>
          <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-ink-600 text-pretty dark:text-ink-300">
            Honest, hands-on reviews of the best SaaS &amp; AI tools — tested,
            compared, and rated for real work. Skip the trial and error.
          </p>

          <HomeSearch client:load articles={allArticles} guides={guides} />

          <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
            <span class="text-xs font-medium text-ink-400 dark:text-ink-500">Browse:</span>
            {categories.map((c) => (
              <a
                href={`/reviews/${c.slug}`}
                class="rounded-full bg-ink-100 px-3 py-1 text-xs font-semibold text-ink-600 transition-colors hover:bg-ink-900 hover:text-white dark:bg-ink-800 dark:text-ink-300 dark:hover:bg-accent-600 dark:hover:text-white"
              >
                {c.name}
              </a>
            ))}
          </div>

          <div class="mx-auto mt-5 flex items-center justify-center">
            <a
              href="/reviews"
              class="inline-flex items-center gap-2 rounded-full bg-amber-400 px-6 py-3 text-sm font-bold text-ink-950 shadow-md shadow-amber-400/30 transition-all hover:bg-accent-600 hover:text-white hover:shadow-lg hover:shadow-accent-600/30 active:scale-[0.98]"
            >
              Browse all reviews
              <ArrowRight class="h-4 w-4" />
            </a>
          </div>
        </div>

        <div class="mx-auto mt-9 grid max-w-4xl grid-cols-2 gap-6 border-t border-ink-200/60 pt-7 sm:grid-cols-4 dark:border-ink-700/60">
          {[
            { value: String(reviews.length + comparisons.length), label: 'Articles published' },
            { value: String(categories.length), label: 'Categories' },
            { value: 'Named', label: 'Reviewers, every piece' },
            { value: '0', label: 'Paid reviews' },
          ].map((stat) => (
            <div class="text-center">
              <p class="font-serif text-3xl font-medium text-ink-900 dark:text-ink-100 sm:text-4xl">{stat.value}</p>
              <p class="mt-1 text-sm font-medium text-ink-500 dark:text-ink-400">{stat.label}</p>
            </div>
          ))}
        </div>

        <div class="mx-auto mt-7 grid max-w-4xl grid-cols-2 gap-3 border-t border-ink-200/60 pt-7 sm:grid-cols-4 dark:border-ink-700/60">
          {[
            { icon: ShieldCheck, title: '100% Independent', subtitle: 'No vendor influence' },
            { icon: Hand, title: 'Real Testing', subtitle: 'Hands-on or sourced' },
            { icon: CalendarClock, title: 'Updated 2026', subtitle: 'Current pricing' },
            { icon: BadgeCheck, title: 'No Paid Rankings', subtitle: 'Never for sale' },
          ].map((item) => (
            <div
              class="flex items-center gap-3 rounded-xl border border-ink-200/70 bg-white p-3 shadow-sm ring-1 ring-ink-100/60 dark:border-ink-700/70 dark:bg-ink-900/80 dark:ring-ink-800/60"
            >
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-accent-400 to-accent-600 text-white shadow-md shadow-accent-500/25 dark:from-accent-500 dark:to-accent-700">
                <item.icon class="h-5 w-5" />
              </div>
              <div class="min-w-0">
                <p class="text-[13px] font-bold leading-tight text-amber-600 dark:text-amber-400">{item.title}</p>
                <p class="mt-0.5 text-xs font-medium text-sand-700 dark:text-sand-300">{item.subtitle}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- How to choose -->
  <section class="bg-ink-50 py-20 lg:py-28 dark:bg-ink-900">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-3 flex items-center gap-1.5">
            <BookOpen class="h-3.5 w-3.5" />
            Buying guide
          </p>
          <h2 class="section-title text-red-600 dark:text-red-400">How to choose the right tool</h2>
          <p class="mt-3 max-w-xl text-sm text-ink-500 dark:text-ink-400">
            Before you compare specs and prices, learn the framework. These guides walk you
            through what actually matters in each category.
          </p>
        </div>
        <a href="/guides" class="inline-flex items-center gap-1 rounded-full bg-amber-400 px-4 py-1.5 text-sm font-semibold text-ink-900 transition-colors hover:bg-accent-600 hover:text-white dark:bg-amber-400/90 dark:text-ink-950 dark:hover:bg-accent-500 dark:hover:text-white">
          All buyer's guides
          <ArrowRight class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredGuides.map((g) => {
          const tag = g.tags[0]
          const meta = categories.find((c) => c.slug === tag)
          const Icon = categoryIcons[tag as CategorySlug] ?? BookOpen
          return (
            <a
              href={`/guides/${g.slug}`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-ink-200/80 bg-white shadow-sm transition-all hover:-translate-y-1 hover:border-accent-300 hover:shadow-lg dark:border-ink-700/80 dark:bg-ink-950"
            >
              <div class="flex h-32 items-center justify-center bg-gradient-to-br from-accent-50 to-ink-50 dark:from-accent-500/10 dark:to-ink-900">
                <div class={`flex h-14 w-14 items-center justify-center rounded-2xl ${meta?.accentClass ?? 'text-accent-600 bg-accent-50 dark:bg-accent-500/10'}`}>
                  <Icon class="h-7 w-7" />
                </div>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap gap-2">
                  {(g.tags ?? []).map((t) => {
                    const m = categories.find((c) => c.slug === t)
                    return (
                      <span class="rounded-full bg-ink-100 px-2.5 py-0.5 text-xs font-semibold text-ink-600 dark:bg-ink-800 dark:text-ink-300">
                        #{m?.name ?? t}
                      </span>
                    )
                  })}
                </div>
                <h3 class="mt-3 font-serif text-lg font-semibold text-ink-900 dark:text-ink-100">{g.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600 dark:text-ink-400">{g.summary}</p>
                <div class="mt-5 flex items-center justify-between">
                  <span class="flex items-center gap-1.5 text-xs font-medium text-ink-500 dark:text-ink-400">
                    <Clock class="h-3.5 w-3.5" />
                    {g.readTime} min read
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-700 group-hover:text-accent-900 dark:text-accent-400 dark:group-hover:text-accent-300">
                    Read Guide
                    <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
                  </span>
                </div>
              </div>
            </a>
          )
        })}
      </div>
    </div>
  </section>

  <!-- Top tools comparison -->
  <section class="bg-white py-20 lg:py-28 dark:bg-ink-950">
    <div class="container-page">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-3 flex items-center gap-1.5">
            <BarChart3 class="h-3.5 w-3.5" />
            At a Glance
          </p>
          <h2 class="section-title text-red-600 dark:text-red-400">Top tools comparison</h2>
        </div>
        <a href="/comparisons" class="inline-flex items-center gap-1 rounded-full bg-amber-400 px-4 py-1.5 text-sm font-semibold text-ink-900 transition-colors hover:bg-accent-600 hover:text-white dark:bg-amber-400/90 dark:text-ink-950 dark:hover:bg-accent-500 dark:hover:text-white">
          All comparisons
          <ArrowRight class="h-3.5 w-3.5" />
        </a>
      </div>
      <div class="mt-8 overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-sm dark:border-ink-700 dark:bg-ink-900">
        <ComparisonTable />
      </div>
    </div>
  </section>

  <!-- Editor's picks -->
  <section class="bg-ink-50 py-20 lg:py-28 dark:bg-ink-900">
    <div class="container-page">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-3 flex items-center gap-1.5">
            <Star class="h-3.5 w-3.5 fill-current" />
            Top Picks
          </p>
          <h2 class="section-title text-red-600 dark:text-red-400">Editor's picks</h2>
        </div>
        <a href="/reviews" class="inline-flex items-center gap-1 rounded-full bg-amber-400 px-4 py-1.5 text-sm font-semibold text-ink-900 transition-colors hover:bg-accent-600 hover:text-white dark:bg-amber-400/90 dark:text-ink-950 dark:hover:bg-accent-500 dark:hover:text-white">
          All reviews
          <ArrowRight class="h-3.5 w-3.5" />
        </a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {topPicks.map((review) => <ReviewCard review={review} />)}
      </div>
    </div>
  </section>

  <!-- Latest reviews -->
  <section class="bg-white py-20 lg:py-28 dark:bg-ink-950">
    <div class="container-page">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-3 flex items-center gap-1.5">
            <TrendingUp class="h-3.5 w-3.5" />
            Latest
          </p>
          <h2 class="section-title">Latest reviews</h2>
        </div>
      </div>
      <div class="mt-10 space-y-1">
        {recentReviews.map((review, i) => {
          const cat = categories.find((c) => c.slug === review.category)
          return (
            <div class="group flex items-center gap-4 border-b border-ink-100 py-5 transition-colors hover:bg-ink-50/50 dark:border-ink-800 dark:hover:bg-ink-900/50">
              <span class="hidden w-8 font-serif text-2xl font-medium text-ink-300 sm:block dark:text-ink-600">{String(i + 1).padStart(2, '0')}</span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  {cat && (
                    <a href={`/reviews/${review.category}`} class={`rounded-full px-2.5 py-0.5 text-xs font-semibold transition-opacity hover:opacity-70 ${cat.accentClass}`}>
                      {cat.name}
                    </a>
                  )}
                  {review.editorsPick && (
                    <span class="inline-flex items-center gap-1 rounded-full bg-ink-900 px-2 py-0.5 text-xs font-semibold text-white dark:bg-accent-600">
                      <Star class="h-2.5 w-2.5 fill-current" />
                      Pick
                    </span>
                  )}
                </div>
                <a href={reviewPath(review)}>
                  <h3 class="mt-1.5 font-serif text-lg font-medium tracking-tight text-ink-900 group-hover:text-accent-700 dark:text-ink-100 dark:group-hover:text-accent-400">
                    {review.name} Review 2026
                  </h3>
                </a>
                <p class="mt-0.5 truncate text-sm text-ink-500 dark:text-ink-400">{review.tagline}</p>
              </div>
              <div class="hidden flex-shrink-0 items-center gap-4 sm:flex">
                <span class="flex items-center gap-1 text-xs font-medium text-ink-400 dark:text-ink-500">
                  <Clock class="h-3.5 w-3.5" />
                  {review.readTime} min
                </span>
                <span class="flex items-center gap-1 text-sm font-semibold text-ink-700 dark:text-ink-300">
                  <Star class="h-4 w-4 fill-sand-400 text-sand-400" />
                  {review.rating.toFixed(1)}
                </span>
              </div>
              <a href={reviewPath(review)} aria-label={`Read ${review.name} review`} class="flex-shrink-0">
                <ArrowRight class="h-5 w-5 text-ink-300 transition-transform group-hover:translate-x-1 group-hover:text-accent-600 dark:text-ink-600" />
              </a>
            </div>
          )
        })}
      </div>
    </div>
  </section>

  <!-- Category deep-dive -->
  {categories.map((category) => {
    const catReviews = reviews.filter((r) => r.category === category.slug)
    if (catReviews.length === 0) return null
    return (
      <section class="bg-ink-50 py-16 lg:py-24 dark:bg-ink-900">
        <div class="container-page">
          <div class="flex items-end justify-between gap-4">
            <div>
              <p class="eyebrow mb-2">{category.tagline}</p>
              <h2 class="section-title text-red-600 dark:text-red-400">{category.name}</h2>
              <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">{categorySubtitles[category.slug]}</p>
            </div>
            <a href={`/reviews/${category.slug}`} class="inline-flex items-center gap-1 rounded-full bg-amber-400 px-4 py-1.5 text-sm font-semibold text-ink-900 transition-colors hover:bg-accent-600 hover:text-white dark:bg-amber-400/90 dark:text-ink-950 dark:hover:bg-accent-500 dark:hover:text-white">
              View all
              <ArrowRight class="h-3.5 w-3.5" />
            </a>
          </div>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {catReviews.slice(0, 3).map((review) => <ReviewCard review={review} />)}
          </div>
        </div>
      </section>
    )
  })}

  <!-- Browse categories -->
  <section class="bg-white py-20 lg:py-28 dark:bg-ink-950">
    <div class="container-page">
      <p class="eyebrow mb-3 text-center">Browse by category</p>
      <h2 class="section-title text-center">Explore all categories</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((category) => <CategoryCard category={category} />)}
      </div>
    </div>
  </section>

  <!-- Why trust us -->
  <section class="bg-ink-900 py-20 lg:py-28 text-white">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-accent-400">Why trust us</p>
        <h2 class="mt-3 font-serif text-3xl font-medium tracking-tight text-white sm:text-4xl">
          Reviews you can actually trust
        </h2>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {editorialValues.map((value) => (
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-white/10">
              <ShieldCheck class="h-6 w-6 text-accent-400" />
            </div>
            <h3 class="mt-4 font-serif text-lg font-medium text-white">{value.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-300">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
