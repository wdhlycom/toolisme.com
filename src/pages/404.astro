---
import { Home, ArrowLeft } from 'lucide-react'
import SiteHeader from '@/components/SiteHeader'
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      ;(function () {
        try {
          var stored = localStorage.getItem('theme')
          if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark')
          }
        } catch (e) {}
      })()
    </script>
    <title>Page not found — Toolisme</title>
    <meta name="description" content="The page you were looking for could not be found." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;..144,500;..144,600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-ink-50 text-ink-900 antialiased dark:bg-ink-950 dark:text-ink-100">
    <div class="flex min-h-screen flex-col">
      <SiteHeader client:load />

      <main class="flex flex-1 items-center justify-center px-5 py-20">
        <div class="text-center">
          <p class="font-serif text-8xl font-medium text-ink-200 dark:text-ink-700">404</p>
          <h1 class="mt-4 font-serif text-3xl font-medium tracking-tight text-ink-900 dark:text-ink-100">
            Page not found
          </h1>
          <p class="mx-auto mt-3 max-w-md text-ink-600 text-pretty dark:text-ink-300">
            The page you are looking for may have been moved or no longer exists.
          </p>
          <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="/" class="btn-primary">
              <Home class="h-4 w-4" />
              Back to home
            </a>
            <button id="go-back" class="btn-secondary" type="button">
              <ArrowLeft class="h-4 w-4" />
              Go back
            </button>
          </div>
        </div>
      </main>

      <footer class="border-t border-ink-200/70 bg-white py-10 dark:border-ink-700/70 dark:bg-ink-950">
        <div class="container-page text-sm text-ink-500 dark:text-ink-400">
          <p>© {new Date().getFullYear()} Toolisme. Independent, hands-on tool reviews.</p>
        </div>
      </footer>
    </div>

    <script>
      const btn = document.getElementById('go-back')
      if (btn) {
        btn.addEventListener('click', () => window.history.back())
      }
    </script>
  </body>
</html>
