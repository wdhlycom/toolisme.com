---
import { authorDetails } from '@/data/content'
import PageHeader from '@/components/PageHeader'

export async function getStaticPaths() {
  return authorDetails.map((a) => ({
    params: { slug: a.slug },
    props: { author: a },
  }))
}

const { author } = Astro.props
const SITE_BASE = 'https://toolisme.com'

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  jobTitle: author.role,
  description: author.about,
  url: `${SITE_BASE}/author/${author.slug}`,
  ...(author.sameAs.length > 0 ? { sameAs: author.sameAs } : {}),
}

const howLabel = author.slug === 'holive' ? 'How I work' : 'How I test'
const socials = author.socials.filter((s) => s.url && s.url !== '#')
import Layout from '@/layouts/Layout.astro'
---
<Layout title={`${author.name} — Toolisme`} description={author.role}>

<article>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <PageHeader
    eyebrow="Author"
    title={author.name}
    description={author.role}
    breadcrumbs={[{ label: 'Editorial Team', to: '/editorial-team' }, { label: author.name }]}
  />

  <section class="container-page py-16">
    <div class="mx-auto max-w-3xl">
      <div class="flex items-center gap-5">
        <img
          src={author.avatar}
          alt={author.name}
          class="h-20 w-20 flex-shrink-0 rounded-2xl object-cover"
        />
        <div>
          <h2 class="font-serif text-2xl font-medium tracking-tight text-ink-900 dark:text-ink-100">
            {author.role}
          </h2>
          <p class="mt-1 text-sm text-ink-400">{author.location}</p>
        </div>
      </div>

      <h3 class="mt-10 font-serif text-xl font-medium text-ink-900 dark:text-ink-100">
        About {author.name}
      </h3>
      <p class="mt-3 text-base leading-relaxed text-ink-600 dark:text-ink-300">
        {author.about}
      </p>

      <h3 class="mt-10 font-serif text-xl font-medium text-ink-900 dark:text-ink-100">
        Expertise
      </h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {author.expertise.map((e) => (
          <span
            class="rounded-full bg-ink-100 px-3 py-1 text-xs font-semibold text-ink-600 dark:bg-ink-800 dark:text-ink-300"
          >
            {e}
          </span>
        ))}
      </div>

      <h3 class="mt-10 font-serif text-xl font-medium text-ink-900 dark:text-ink-100">
        {howLabel}
      </h3>
      <p class="mt-3 text-base leading-relaxed text-ink-600 dark:text-ink-300">
        {author.howIWork}
      </p>

      {socials.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {socials.map((s) => (
            <a
              href={s.url}
              target={s.url.startsWith('http') ? '_blank' : undefined}
              rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="rounded-full bg-ink-100 px-3 py-1 text-xs font-semibold text-ink-600 transition-colors hover:bg-ink-900 hover:text-white dark:bg-ink-800 dark:text-ink-300 dark:hover:bg-ink-100 dark:hover:text-ink-900"
            >
              {s.label}
            </a>
          ))}
        </div>
      )}

      <p class="mt-12 border-t border-ink-100 pt-6 text-xs text-ink-400 dark:border-ink-800">
        {author.disclosure}{' '}
        <a href="/disclosure" class="font-medium text-ink-600 hover:text-ink-900 dark:text-ink-300 dark:hover:text-ink-200">
          Read our disclosure
        </a>.
      </p>
    </div>
  </section>
</article>

</Layout>
